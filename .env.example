# ========================================================
# TEANIS HEADLESS WORDPRESS + NUXT 4 - ENVIRONMENT TEMPLATE
# ========================================================

# 1. Frontend Configuration
# Trên Local: http://localhost:3000 | Trên Vercel Production: https://teanis.com
SITE_URL=http://localhost:3000

# 2. WordPress Backend Endpoints
# Trên Local: headless-landing.local | Trên Pantheon: dev-teanis-cms.pantheonsite.io
WP_DOMAIN=headless-landing.local
WP_GRAPHQL_URL=http://headless-landing.local/graphql
WP_API_URL=http://headless-landing.local/wp-json

# 3. Server-to-Server Security
# Secret key xác thực giữa Nuxt Nitro và WordPress khi lưu liên hệ khách hàng
WP_HEADLESS_SECRET=teanis_secret_lead_2026

# Secret key cho webhook revalidation (tuỳ chọn)
WP_WEBHOOK_SECRET=your_webhook_secret_key

# 4. Contact Form & Email Notification
# Email nhận thông báo khi khách gửi form liên hệ
CONTACT_RECEIVE_EMAIL=trieuncn@teanis.vn

# Cấu hình SMTP gửi mail (Tuỳ chọn: Gmail SMTP, Resend, SendGrid...)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 5. WordPress Auth (Tuỳ chọn cho tính năng xem trước bài viết nháp)
WP_APP_USER=
WP_APP_PASSWORD=
